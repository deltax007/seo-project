dding":"0.4rem 0.75rem","backgroundColor":"rgba(255, 255, 255, 0.03)","borderBottom":"1px solid var(--border-subtle)","fontSize":"12px","fontFamily":"var(--font-mono)","color":"var(--text-muted)"},"children":"Account.java"}],["$","pre",null,{"style":{"padding":"1rem","overflowX":"auto","color":"#e2e8f0","fontSize":"13px","lineHeight":1.5},"children":["$","code",null,{"children":"@Entity\n@Table(name = \"accounts\")\npublic class Account {\n    @Id\n    private String accountNumber;\n\n    @Column(nullable = false)\n    private Long balanceCents;\n\n    @Version\n    private Long version;\n\n    public void debit(Long amount) {\n        if (this.balanceCents < amount) {\n            throw new InsufficientFundsException(\"Account has insufficient balance\");\n        }\n        this.balanceCents -= amount;\n    }\n\n    public void credit(Long amount) {\n        this.balanceCents += amount;\n    }\n}"}]}]]}]]}],["$","div","2",{"style":{"borderLeft":"2px solid var(--border-medium)","paddingLeft":"1.25rem","position":"relative"},"children":[["$","div",null,{"style":{"position":"absolute","left":"-9px","top":"0","width":"16px","height":"16px","borderRadius":"var(--radius-full)","backgroundColor":"var(--brand-primary)"}}],["$","h3",null,{"style":{"fontSize":"var(--text-lg)","marginBottom":"0.4rem"},"children":["Step ",2,": ","Atomic Transfer Service with Row Locking"]}],["$","p",null,{"style":{"fontSize":"var(--text-sm)","color":"var(--text-secondary)","marginBottom":"0.75rem","lineHeight":1.6},"children":"Execute transfer inside `@Transactional` boundary, acquiring pessimistic write locks on both accounts ordered by account number to prevent database deadlocks."}],["$","div",null,{"style":{"backgroundColor":"var(--bg-secondary)","border":"1px solid var(--border-subtle)","borderRadius":"var(--radius-md)","overflow":"hidden"},"children":[["$","div",null,{"style":{"padding":"0.4rem 0.75rem","backgroundColor":"rgba(255, 255, 255, 0.03)","borderBottom":"1px solid var(--border