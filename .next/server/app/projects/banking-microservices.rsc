29:["$","section",null,{"className":"card-base","children":[["$","div",null,{"style":{"display":"flex","alignItems":"center","gap":"0.5rem","marginBottom":"1rem"},"children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":20,"height":20,"viewBox":"0 0 24 24","fill":"none","stroke":"var(--brand-primary)","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-help","children":[["$","circle","1mglay",{"cx":"12","cy":"12","r":"10"}],["$","path","1u773s",{"d":"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"}],["$","path","p32p05",{"d":"M12 17h.01"}],"$undefined"]}],["$","h2",null,{"style":{"fontSize":"var(--text-2xl)"},"children":"Placement Viva & Technical Questions"}]]}],["$","p",null,{"style":{"color":"var(--text-secondary)","marginBottom":"1.5rem","fontSize":"var(--text-sm)"},"children":"Questions commonly asked by college examiners and product company interviewers regarding this project architecture."}],["$","$L36",null,{"items":[{"id":"iq-0","title":"Why store monetary values in integers/cents rather than Double or Float?","categoryBadge":"Technical","content":"Floating-point numbers in computer architectures cannot accurately represent decimal fractions in base-2 IEEE 754 standards (e.g., 0.1 + 0.2 = 0.30000000000000004). In banking systems, this causes roundoff discrepancy leaks over millions of transactions. We store monetary amounts in atomic integer units (cents/paise) or use Java's BigDecimal with explicit rounding modes."},{"id":"iq-1","title":"What is pessimistic locking vs optimistic locking, and why did you choose it for balance transfers?","categoryBadge":"Architecture","content":"Optimistic locking checks version timestamps at commit time; if conflict occurs, an OptimisticLockException is thrown and the operation is rolled back. In high-contention banking scenarios (e.g. flash sales or concurrent billing), frequent rollbacks waste server cycles. Pessimistic locking (SELECT FOR UPDATE) blocks subsequent transactions directly in the database until the holding transaction finishes, guaranteeing transactional serialization."},{"id":"iq-2","title":"How did you prevent database deadlocks when two accounts transfer money to each other simultaneously?","categoryBadge":"Placement","content":"Deadlocks occur when Thread A locks Account 1 and waits for Account 2, while Thread B locks Account 2 and waits for Account 1. We resolved this by enforcing global lock ordering: accounts are always locked in alphabetical/lexicographical order of their account IDs, breaking the circular wait condition required for deadlocks."}]}]]}]
2a:["$","section",null,{"className":"card-base","children":[["$","h2",null,{"style":{"fontSize":"var(--text-2xl)","marginBottom":"1.25rem"},"children":"Project FAQs"}],["$","$L36",null,{"items":[{"id":"faq-0","title":"Is Spring Boot suitable for campus placement interviews at top product firms?","content":"Yes. Enterprise backend roles at banks, fintechs, and product firms place heavy emphasis on Spring Boot, ACID transactions, database locking, and microservices architecture."},{"id":"faq-1","title":"Can this project be run using Docker Compose?","content":"Yes. A single `docker compose up` command starts PostgreSQL, initializes the schema, and starts the Spring Boot service container."}]}]]}]
