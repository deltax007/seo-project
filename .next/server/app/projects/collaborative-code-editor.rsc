orderBottom":"1px solid var(--border-subtle)","fontSize":"12px","fontFamily":"var(--font-mono)","color":"var(--text-muted)"},"children":"socket-server.ts"}],["$","pre",null,{"style":{"padding":"1rem","overflowX":"auto","color":"#e2e8f0","fontSize":"13px","lineHeight":1.5},"children":["$","code",null,{"children":"import { Server } from 'socket.io';\n\nexport function setupSocket(io: Server) {\n  io.on('connection', (socket) => {\n    socket.on('join-room', (roomId: string, username: string) => {\n      socket.join(roomId);\n      socket.to(roomId).emit('user-joined', { userId: socket.id, username });\n\n      socket.on('editor-change', (delta) => {\n        socket.to(roomId).emit('editor-change', delta);\n      });\n\n      socket.on('disconnect', () => {\n        socket.to(roomId).emit('user-left', socket.id);\n      });\n    });\n  });\n}"}]}]]}]]}],["$","div","2",{"style":{"borderLeft":"2px solid var(--border-medium)","paddingLeft":"1.25rem","position":"relative"},"children":[["$","div",null,{"style":{"position":"absolute","left":"-9px","top":"0","width":"16px","height":"16px","borderRadius":"var(--radius-full)","backgroundColor":"var(--brand-primary)"}}],["$","h3",null,{"style":{"fontSize":"var(--text-lg)","marginBottom":"0.4rem"},"children":["Step ",2,": ","Monaco Editor Binding with Yjs Provider"]}],["$","p",null,{"style":{"fontSize":"var(--text-sm)","color":"var(--text-secondary)","marginBottom":"0.75rem","lineHeight":1.6},"children":"Connect React component state to Monaco editor instances, syncing CRDT updates seamlessly across all peers."}],["$","div",null,{"style":{"backgroundColor":"var(--bg-secondary)","border":"1px solid var(--border-subtle)","borderRadius":"var(--radius-md)","overflow":"hidden"},"children":[["$","div",null,{"style":{"padding":"0.4rem 0.75rem","backgroundColor":"rgba(255, 255, 255, 0.03)","borderBottom":"1px solid var(--border-subtle)","fontSize":"12px","fontFamily":"var(--font-mono)","color":"var(--text-muted)"},"children":"EditorComponent.tsx"}],["$","pre",null,{"style":{"padding":"1rem","overflowX":"auto","color":"#e2e8f0","fontSize":"13px","lineHeight":1.5},"children":["$","code",null,{"children":"import React, { useRef, useEffect } from 'react';\nimport Editor from '@monaco-editor/react';\n\nexport const CollaborativeEditor = ({ roomId }: { roomId: string }) => {\n  const editorRef = useRef<any>(null);\n\n  const handleEditorDidMount = (editor: any) => {\n    editorRef.current = editor;\n    // Bind Monaco model to Yjs CRDT provider here\n  };\n\n  return (\n    <div style={{ height: '600px', border: '1px solid #1e293b' }}>\n      <Editor\n        height=\"100%\"\n        defaultLanguage=\"python\"\n        theme=\"vs-dark\"\n        onMount={handleEditorDidMount}\n      />\n    </div>\n  );\n};"}]}]]}]]}]]}]]}]
24:["$","section",null,{"className":"card-base","children":[["$","div",null,{"style":{"display":"flex","alignItems":"center","gap":"0.5rem","marginBottom":"1rem"},"children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":20,"height":20,"viewBox":"0 0 24 24","fill":"none","stroke":"var(--brand-primary)","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-help","children":[["$","circle","1mglay",{"cx":"12","cy":"12","r":"10"}],["$","path","1u773s",{"d":"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"}],["$","path","p32p05",{"d":"M12 17h.01"}],"$undefined"]}],["$","h2",null,{"style":{"fontSize":"var(--text-2xl)"},"children":"Placement Viva & Technical Questions"}]]}],["$","p",null,{"style":{"color":"var(--text-secondary)","marginBottom":"1.5rem","fontSize":"var(--text-sm)"},"children":"Questions commonly asked by college examiners and product company interviewers regarding this project architecture."}],["$","$L2e",null,{"items":[{"id":"iq-0","title":"What is the difference between WebSockets and standard HTTP REST polling?","categoryBadge":"Basic","content":"HTTP REST is unidirectional and request-driven: the client must continuously poll the server to discover updates, creating high HTTP header overhead and latency. WebSockets maintain a persistent, bidirectional, full-duplex TCP connection, allowing the server to push text mutations to clients in microseconds with minimal framing overhead."},{"id":"iq-1","title":"What is a CRDT (Conflict-Free Replicated Data Type), and how does it prevent text corruption?","categoryBadge":"Technical","content":"A CRDT is a distributed data structure that guarantees eventual consistency across multiple nodes without requiring a central coordinator. Unlike naive Operational Transformation (OT) which requires complex server transformation matrices, CRDTs assign unique fractional identifiers and vector timestamps to every character inserted or deleted, ensuring all clients converge to the exact same text state regardless of packet arrival order."},{"id":"iq-2","title":"How did you prevent users from executing malicious code (like 'rm -rf /') in the code runner?","categoryBadge":"Placement","content":"User code is never executed directly on the host operating system. It executes inside ephemeral Docker containers running with non-root user privileges, a read-only root filesystem, disabled network access (`--net=none`), CPU quotas (`--cpus=0.5`), memory limits (`--memory=128m`), and a strict process timeout kill signal."}]}]]}]
