lor":"rgba(255, 255, 255, 0.03)","borderBottom":"1px solid var(--border-subtle)","fontSize":"12px","fontFamily":"var(--font-mono)","color":"var(--text-muted)"},"children":"extractor.py"}],["$","pre",null,{"style":{"padding":"1rem","overflowX":"auto","color":"#e2e8f0","fontSize":"13px","lineHeight":1.5},"children":["$","code",null,{"children":"import fitz  # PyMuPDF\n\ndef extract_text_from_pdf(file_bytes: bytes) -> str:\n    doc = fitz.open(stream=file_bytes, filetype=\"pdf\")\n    text_blocks = []\n    for page in doc:\n        text_blocks.append(page.get_text(\"text\"))\n    return \"\\n\".join(text_blocks).strip()"}]}]]}]]}],["$","div","2",{"style":{"borderLeft":"2px solid var(--border-medium)","paddingLeft":"1.25rem","position":"relative"},"children":[["$","div",null,{"style":{"position":"absolute","left":"-9px","top":"0","width":"16px","height":"16px","borderRadius":"var(--radius-full)","backgroundColor":"var(--brand-primary)"}}],["$","h3",null,{"style":{"fontSize":"var(--text-lg)","marginBottom":"0.4rem"},"children":["Step ",2,": ","Skill Entity Matching with spaCy PhraseMatcher"]}],["$","p",null,{"style":{"fontSize":"var(--text-sm)","color":"var(--text-secondary)","marginBottom":"0.75rem","lineHeight":1.6},"children":"Load an English spaCy model and initialize PhraseMatcher with pre-compiled technical terminology tokens to extract technology entities with zero false positives."}],["$","div",null,{"style":{"backgroundColor":"var(--bg-secondary)","border":"1px solid var(--border-subtle)","borderRadius":"var(--radius-md)","overflow":"hidden"},"children":[["$","div",null,{"style":{"padding":"0.4rem 0.75rem","backgroundColor":"rgba(255, 255, 255, 0.03)","borderBottom":"1px solid var(--border-subtle)","fontSize":"12px","fontFamily":"var(--font-mono)","color":"var(--text-muted)"},"children":"ner_pipeline.py"}],["$","pre",null,{"style":{"padding":"1rem","overflowX":"auto","color":"#e2e8f0","fontSize":"13px","lineHeight":1.5},"children":["$","code",null,{"children":"import spacy\nfrom spacy.matcher import PhraseMatcher\n\nnlp = spacy.load(\"en_core_web_sm\")\nmatcher = PhraseMatcher(nlp.vocab, attr=\"LOWER\")\n\nTECH_SKILLS = [\"Python\", \"FastAPI\", \"Docker\", \"PostgreSQL\", \"PyTorch\", \"React\"]\npatterns = [nlp.make_doc(skill) for skill in TECH_SKILLS]\nmatcher.add(\"TECH_SKILLS\", patterns)\n\ndef extract_skills(text: str) -> list[str]:\n    doc = nlp(text)\n    matches = matcher(doc)\n    return sorted(list({doc[start:end].text for _, start, end in matches}))"}]}]]}]]}],"$L36"]}]]}]
2a:["$","section",null,{"className":"card-base","children":[["$","div",null,{"style":{"display":"flex","alignItems":"center","gap":"0.5rem","marginBottom":"1rem"},"children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":20,"height":20,"viewBox":"0 0 24 24","fill":"none","stroke":"var(--brand-primary)","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-help","children":[["$","circle","1mglay",{"cx":"12","cy":"12","r":"10"}],["$","path","1u773s",{"d":"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"}],["$","path","p32p05",{"d":"M12 17h.01"}],"$undefined"]}],["$","h2",null,{"style":{"fontSize":"var(--text-2xl)"},"children":"Placement Viva & Technical Questions"}]]}],["$","p",null,{"style":{"color":"var(--text-secondary)","marginBottom":"1.5rem","fontSize":"var(--text-sm)"},"children":"Questions commonly asked by college examiners and product company interviewers regarding this project architecture."}],["$","$L37",null,{"items":[{"id":"iq-0","title":"What is the difference between keyword matching and semantic similarity in resume screening?","categoryBadge":"Basic","content":"Keyword matching checks for exact string equality (e.g. searching for 'Node.js' misses 'NodeJS' or 'Express backend developer'). Semantic similarity converts words and sentences into high-dimensional vector embeddings, measuring conceptual proximity via cosine distance regardless of trivial spelling or phrasing variations."},{"id":"iq-1","title":"Why use TF-IDF alongside or in comparison to Transformer-based dense embeddings?","categoryBadge":"Technical","content":"TF-IDF is extremely computationally efficient (sub-1ms per comparison) and gives high mathematical weight to rare technical acronyms (e.g. 'Kubernetes', 'gRPC'). Dense transformer embeddings excel at understanding broad descriptive context (e.g. 'led high-scale cloud migration'), but can sometimes smooth out specific hard tool names. A hybrid approach combines the precision of lexical scoring with the comprehension of dense embeddings."},{"id":"iq-2","title":"How would you handle 10,000 resume uploads during a campus drive without crashing the server?","categoryBadge":"Architecture","content":"I would decouple ingestion from extraction using a producer-consumer message queue (e.g. RabbitMQ or Redis Streams). The upload endpoint immediately saves the file to object storage (like AWS S3 or MinIO), writes an ingestion task to the queue, and returns an HTTP 202 Accepted with a job token. Background worker processes scale independently to consume parsing jobs without blocking web server threads."},{"id":"iq-3","title":"How did you validate that your NLP parser does not produce false positives on section titles?","categoryBadge":"Placement","content":"We implemented layout-aware filtering using bounding-box spatial coordinates from PyMuPDF. Text categorized as header blocks (based on font size and uppercase weight) is isolated from body experience descriptions, preventing section names like 'EDUCATION' or 'PROJECTS' from being tagged as skills."}]}]]}]
2b:["$","section",null,{"className":"card-base","children":[["$","h2",null,{"style":{"fontSize":"var(--text-2xl)","marginBottom":"1.25rem"},"children":"Project FAQs"}],["$","$L37",null,{"items":[{"id":"faq-0","title":"Is this project suitable for a Final Year CSE major project?","content":"Yes. It combines applied NLP, data parsing, machine learning evaluation metrics, and asynchronous backend engineering, providing plenty of depth for viva examinations and live demonstrations."},{"id":"faq-1","title":"Can this project run entirely on a local machine without expensive GPUs?","content":"Yes. Both spaCy CPU models (en_core_web_sm) and Scikit-Learn TF-IDF vectorizers run in milliseconds on standard laptops with 8GB RAM."}]}]]}]
