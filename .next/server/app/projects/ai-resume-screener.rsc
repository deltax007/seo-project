36:["$","div","3",{"style":{"borderLeft":"2px solid var(--border-medium)","paddingLeft":"1.25rem","position":"relative"},"children":[["$","div",null,{"style":{"position":"absolute","left":"-9px","top":"0","width":"16px","height":"16px","borderRadius":"var(--radius-full)","backgroundColor":"var(--brand-primary)"}}],["$","h3",null,{"style":{"fontSize":"var(--text-lg)","marginBottom":"0.4rem"},"children":["Step ",3,": ","Vector Similarity Engine & FastAPI Endpoint"]}],["$","p",null,{"style":{"fontSize":"var(--text-sm)","color":"var(--text-secondary)","marginBottom":"0.75rem","lineHeight":1.6},"children":"Implement cosine similarity computation using scikit-learn's TfidfVectorizer or sentence-transformers, exposed through an asynchronous FastAPI route."}],["$","div",null,{"style":{"backgroundColor":"var(--bg-secondary)","border":"1px solid var(--border-subtle)","borderRadius":"var(--radius-md)","overflow":"hidden"},"children":[["$","div",null,{"style":{"padding":"0.4rem 0.75rem","backgroundColor":"rgba(255, 255, 255, 0.03)","borderBottom":"1px solid var(--border-subtle)","fontSize":"12px","fontFamily":"var(--font-mono)","color":"var(--text-muted)"},"children":"main.py"}],["$","pre",null,{"style":{"padding":"1rem","overflowX":"auto","color":"#e2e8f0","fontSize":"13px","lineHeight":1.5},"children":["$","code",null,{"children":"from fastapi import FastAPI, UploadFile, File\nfrom sklearn.feature_extraction.text import TfidfVectorizer\nfrom sklearn.metrics.pairwise import cosine_similarity\n\napp = FastAPI(title=\"Resume Screening Engine\")\n\n@app.post(\"/api/v1/score\")\nasync def calculate_score(resume_text: str, job_text: str):\n    vectorizer = TfidfVectorizer(stop_words=\"english\")\n    tfidf_matrix = vectorizer.fit_transform([resume_text, job_text])\n    similarity = cosine_similarity(tfidf_matrix[0:1], tfidf_matrix[1:2])[0][0]\n    return {\"match_score\": round(float(similarity) * 100, 2)}"}]}]]}]]}]
